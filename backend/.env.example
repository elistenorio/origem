# Copie para .env e preencha. Nunca coloque credenciais reais neste arquivo.

# Ambiente: "development" (local) ou "production" (Render). Em produção o cookie vai com secure e sameSite=none.
NODE_ENV=development
PORT=3001

# Conexão usada pela aplicação.
# Local (docker-compose): postgresql://postgres:postgres@localhost:5434/origem?schema=public
# Supabase: URL do pooler (Transaction), porta 6543, com ?pgbouncer=true
DATABASE_URL=

# Conexão direta, usada pelo Prisma nas migrations.
# Local: a mesma da DATABASE_URL.
# Supabase: conexão direta (ou Session pooler), porta 5432
DIRECT_URL=

# Segredo para assinar o JWT. Use um texto longo e aleatório em produção.
JWT_SECRET=

# Endereço exato do frontend, para o CORS (sem "/" no fim). Local: http://localhost:3000
FRONTEND_URL=
